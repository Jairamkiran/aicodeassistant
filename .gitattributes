# Normalize line endings: LF in the repo for all text; tools handle checkout.
* text=auto eol=lf

# Windows batch + the Gradle wrapper cmd must stay CRLF to run on Windows.
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Shell scripts and the gradlew launcher must be LF.
*.sh         text eol=lf
gradlew      text eol=lf

# Binary artifacts — never touch.
*.jar        binary
*.png        binary
*.jpg        binary
*.ico        binary
